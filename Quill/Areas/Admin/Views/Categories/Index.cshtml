@model List<Category>
@{
    ViewData["Title"] = "分类管理";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">分类管理</h4>
    <a class="btn btn-primary btn-sm" asp-action="Create">新建分类</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>分类名称</th>
                    <th>Slug</th>
                    <th>描述</th>
                    <th class="text-center">文章数</th>
                    <th class="text-center">排序</th>
                    <th class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">暂无分类</td>
                    </tr>
                }
                else
                {
                    foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.ParentName@c.Name</td>
                            <td class="small text-muted">@c.Slug</td>
                            <td class="small text-muted">@c.Description</td>
                            <td class="text-center">@c.ArticleCount</td>
                            <td class="text-center small">@c.SortOrder</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">编辑</a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('确定删除分类「@c.Name」？其下文章将变为未分类。');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">删除</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
