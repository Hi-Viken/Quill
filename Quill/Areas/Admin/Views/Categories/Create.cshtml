@model Category
@{
    ViewData["Title"] = "新建分类";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">新建分类</h4>
    <a class="btn btn-sm btn-outline-secondary" asp-action="Index">返回列表</a>
</div>

<form asp-action="Create" method="post" class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">名称</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Slug" class="form-label">Slug（别名）</label>
                <input asp-for="Slug" class="form-control" placeholder="留空则自动生成" />
                <span asp-validation-for="Slug" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ParentId" class="form-label">上级分类</label>
                <select asp-for="ParentId" class="form-select" asp-items="ViewBag.ParentList"></select>
            </div>
            <div class="col-md-6">
                <label asp-for="SortOrder" class="form-label">排序（数字越小越靠前）</label>
                <input asp-for="SortOrder" class="form-control" type="number" />
                <span asp-validation-for="SortOrder" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label">描述</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <button type="submit" class="btn btn-primary">保存分类</button>
        <a class="btn btn-link" asp-action="Index">取消</a>
    </div>
</form>
