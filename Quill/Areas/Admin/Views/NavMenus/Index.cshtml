@model List<NavMenu>
@{
    ViewData["Title"] = "导航菜单";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">导航菜单</h4>
    <a class="btn btn-primary btn-sm" asp-action="Create">新建菜单项</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>菜单名称</th>
                    <th>链接来源 / 地址</th>
                    <th class="text-center">打开方式</th>
                    <th class="text-center">外链</th>
                    <th class="text-center">排序</th>
                    <th class="text-center">显示</th>
                    <th class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">暂无菜单项</td>
                    </tr>
                }
                else
                {
                    foreach (var m in Model)
                    {
                        <tr>
                            <td>
                                @m.ParentName@m.Title
                                @if (!string.IsNullOrEmpty(m.Icon))
                                {
                                    <span class="text-muted small">（图标：@m.Icon）</span>
                                }
                            </td>
                            <td class="small">
                                @if (m.IsBound && !m.IsBroken)
                                {
                                    <span class="badge bg-primary-subtle text-primary-emphasis">@m.LinkTypeLabel</span>
                                    <span class="ms-1">@m.BoundName</span>
                                    <div class="text-muted"><code>@m.EffectiveUrl</code></div>
                                }
                                else if (m.IsBroken)
                                {
                                    <span class="badge bg-danger">绑定已失效</span>
                                    <div class="text-muted"><code>@m.EffectiveUrl</code></div>
                                }
                                else
                                {
                                    <span class="text-muted">@m.EffectiveUrl</span>
                                }
                            </td>
                            <td class="text-center small">@m.Target</td>
                            <td class="text-center small">@(m.IsExternal ? "是" : "否")</td>
                            <td class="text-center small">@m.SortOrder</td>
                            <td class="text-center">
                                @if (m.IsVisible)
                                {
                                    <span class="badge bg-success">显示</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">隐藏</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@m.Id">编辑</a>
                                <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('确定删除菜单项「@m.Title」？');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">删除</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
