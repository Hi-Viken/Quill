@model NavMenu
@{
    ViewData["Title"] = "编辑菜单项";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">编辑菜单项</h4>
    <a class="btn btn-sm btn-outline-secondary" asp-action="Index">返回列表</a>
</div>

<form asp-action="Edit" method="post" class="card">
    <input type="hidden" asp-for="Id" />
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>
        <partial name="_FormFields" model="Model" />
    </div>
    <div class="card-footer">
        <button type="submit" class="btn btn-primary">保存修改</button>
        <a class="btn btn-link" asp-action="Index">取消</a>
    </div>
</form>
