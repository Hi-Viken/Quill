@model List<Page>
@{
    ViewData["Title"] = "独立页面";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">独立页面</h4>
    <a class="btn btn-primary btn-sm" asp-action="Create">新建页面</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>标题</th>
                    <th>Slug</th>
                    <th class="text-center">状态</th>
                    <th class="text-center">排序</th>
                    <th class="text-center">允许评论</th>
                    <th>更新时间</th>
                    <th class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">暂无独立页面</td>
                    </tr>
                }
                else
                {
                    foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@p.Title</td>
                            <td class="small text-muted">/page/@p.Slug</td>
                            <td class="text-center">
                                @if (p.IsPublished)
                                {
                                    <span class="badge bg-success">已发布</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">隐藏</span>
                                }
                            </td>
                            <td class="text-center small">@p.SortOrder</td>
                            <td class="text-center small">@(p.AllowComment ? "是" : "否")</td>
                            <td class="small">@p.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">编辑</a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('确定删除页面《@p.Title》？');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">删除</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
