<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="SqlSugarCore" Version="5.1.4.221" />
  </ItemGroup>

  <!--
    安全修复：显式提升传递依赖，消除 NU1902 / NU1903。
    依赖链：SqlSugarCore 5.1.4.221 → Oracle.ManagedDataAccess.Core 23.8.0 → System.Security.Cryptography.Pkcs 8.0.1
    受影响的 8.0.1 存在两个已披露问题（修复版本：8.0.2 / 9.0.21 / 10.0.13）：
      - CVE-2026-84008 (GHSA-846f-f764-76mx, High 7.5)      SignedCms.CheckSignature 重复解析 X.509 数据，可被未认证请求触发二次方级 CPU 耗尽
      - CVE-2026-70162 (GHSA-2fmv-rv2c-59x7, Moderate 5.9) EnvelopedCms.Decode 处理恶意 CMS/PKCS#7 属性时同样存在资源放大
    SqlSugarCore 已是最新版，无法通过升级上游包解决，因此在此直接引用与 net10.0 运行期对齐的补丁版本。
    该程序集不打进共享框架，实际随应用部署，所以必须显式升级才真正生效。
    待 Oracle.ManagedDataAccess.Core 自身依赖提升到 8.0.2+ 后，可删除此项。
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
